# Puerto del servidor web
PORT=3000

# Conexión a la Base de Datos (PostgreSQL / Supabase / Neon)
DATABASE_URL=postgresql://postgres:tu_password@db.tu_proyecto.supabase.co:5432/postgres

# Almacenamiento de Modelos 3D en Supabase Storage (Buckets)
SUPABASE_URL=https://tu_proyecto.supabase.co
# Pega tu clave de API (Project Settings -> API):
SUPABASE_KEY=
# Nombre del Bucket en Supabase (debe ser público):
SUPABASE_BUCKET=models3d
